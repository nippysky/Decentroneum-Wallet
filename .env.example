# Copy this file to .env and fill in real values before building for
# production. Variables prefixed EXPO_PUBLIC_ are embedded in the client
# bundle at build time — never put secrets here, only public identifiers.

# Get a free Project ID at https://cloud.reown.com (formerly
# cloud.walletconnect.com). Required for WalletConnect pairing with
# external dapps to work at all — without it, pairing fails silently.
EXPO_PUBLIC_WALLETCONNECT_PROJECT_ID=
