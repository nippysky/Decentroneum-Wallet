# Electroneum Smart Chain RPC endpoints.
# RPC_URL (https) is only used for startup backfill, reconnect gap-filling,
# and the low-frequency reconcile safety net — not the live delivery path.
# RPC_WS_URL (wss) is the live path: the node pushes new blocks/logs to us
# over one persistent socket instead of us polling. Get the wss:// URL from
# your RPC provider's dashboard (Ankr exposes one per project on paid plans).
RPC_URL=https://rpc.ankr.com/electroneum
# Tried in order, only if RPC_URL fails/times out. Never queried in parallel.
RPC_FALLBACK_URLS=https://rpc.electroneum.com,https://rpc.ankr.com/electroneum
RPC_WS_URL=wss://rpc.ankr.com/electroneum/ws
CHAIN_ID=52014

# Electroneum ERC-20 default token (DCNT) — comma-separated list of tracked
# token contract addresses. Extend this as the token registry grows, or wire
# it up to fetch https://decentroneum.com/api/token-list.json at boot.
TRACKED_TOKENS=0xE74e4E7A064310466f3bdBd3F3Ce4e8c8F7CF1d5

# How often the HTTP reconcile safety net checks the WS subscriptions haven't
# silently missed anything (ms). Not the primary delivery path — see above.
RECONCILE_INTERVAL_MS=90000

# HTTP server
PORT=8787

# SQLite file path (created automatically)
DB_PATH=./data/push.db

# Require registration requests to include a signed proof-of-ownership
# (recommended for production — see src/verify.ts)
REQUIRE_SIGNATURE=true
