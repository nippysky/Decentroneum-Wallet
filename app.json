{
  "expo": {
    "name": "Decent Wallet",
    "slug": "decent-wallet",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "decentwallet",
    "userInterfaceStyle": "automatic",
    "primaryColor": "#4DEE54",
    "backgroundColor": "#060807",
    "description": "Decent Wallet is the non-custodial mobile wallet for the Electroneum Smart Chain ecosystem \u2014 send, receive, and manage ETN and Electroneum ERC-20 tokens with bank-grade security.",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.decentroneum.wallet",
      "buildNumber": "1",
      "icon": {
        "light": "./assets/images/icon.png",
        "dark": "./assets/images/icon-dark.png",
        "tinted": "./assets/images/icon-tinted.png"
      },
      "associatedDomains": [
        "applinks:decentroneum.com",
        "applinks:app.decentroneum.com"
      ],
      "config": {
        "usesNonExemptEncryption": false
      },
      "infoPlist": {
        "NSFaceIDUsageDescription": "Decent Wallet uses Face ID to unlock your wallet and confirm transactions without re-entering your passcode.",
        "NSCameraUsageDescription": "Decent Wallet uses the camera only to scan WalletConnect QR codes so you can connect to apps shown on another screen. Nothing is recorded or uploaded.",
        "ITSAppUsesNonExemptEncryption": false,
        "UIBackgroundModes": [
          "remote-notification"
        ]
      },
      "entitlements": {
        "com.apple.developer.associated-domains": [
          "applinks:decentroneum.com",
          "applinks:app.decentroneum.com"
        ]
      },
      "privacyManifests": {
        "NSPrivacyTracking": false,
        "NSPrivacyTrackingDomains": [],
        "NSPrivacyCollectedDataTypes": [],
        "NSPrivacyAccessedAPITypes": [
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryUserDefaults",
            "NSPrivacyAccessedAPITypeReasons": [
              "CA92.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryFileTimestamp",
            "NSPrivacyAccessedAPITypeReasons": [
              "C617.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategorySystemBootTime",
            "NSPrivacyAccessedAPITypeReasons": [
              "35F9.1"
            ]
          }
        ]
      }
    },
    "android": {
      "package": "com.decentroneum.wallet",
      "versionCode": 1,
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png",
        "backgroundColor": "#4DEE54"
      },
      "predictiveBackGestureEnabled": true,
      "permissions": [
        "CAMERA",
        "android.permission.CAMERA",
        "USE_BIOMETRIC",
        "USE_FINGERPRINT",
        "POST_NOTIFICATIONS",
        "VIBRATE",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "decentroneum.com",
              "pathPrefix": "/wc"
            },
            {
              "scheme": "https",
              "host": "app.decentroneum.com",
              "pathPrefix": "/wc"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png",
      "name": "Decent Wallet",
      "themeColor": "#060807",
      "backgroundColor": "#060807"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "backgroundColor": "#4DEE54",
          "dark": {
            "image": "./assets/images/splash-icon-dark.png",
            "backgroundColor": "#060807"
          }
        }
      ],
      "expo-secure-store",
      "expo-font",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Decent Wallet uses Face ID to unlock your wallet and confirm transactions."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Decent Wallet uses the camera only to scan WalletConnect QR codes so you can connect to apps shown on another screen. Nothing is recorded or uploaded.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notification-icon.png",
          "color": "#4DEE54",
          "defaultChannel": "transactions",
          "enableBackgroundRemoteNotifications": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "e6292d8e-cc92-4c2d-9221-4949b04f981d"
      }
    },
    "owner": "nippysky"
  }
}
