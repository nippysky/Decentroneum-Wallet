# Electroneum Smart Chain RPC endpoints.
# RPC_URL (https) is only used for startup backfill, reconnect gap-filling,
# and the low-frequency reconcile safety net — not the live delivery path.
# RPC_WS_URL (wss) is the live path: the node pushes new blocks/logs to us
# over one persistent socket instead of us polling. Get the wss:// URL from
# your RPC provider's dashboard (Ankr exposes one per project on paid plans).
RPC_URL=https://rpc.ankr.com/electroneum
# Tried in order, only if RPC_URL fails/times out. Never queried in parallel.
RPC_FALLBACK_URLS=https://rpc.electroneum.com,https://rpc.ankr.com/electroneum,https://52014.rpc.thirdweb.com
RPC_WS_URL=wss://rpc.ankr.com/electroneum/ws
CHAIN_ID=52014

# Authoritative token registry. Same URL the mobile wallet reads, which is
# what guarantees the watcher and the wallet can't drift apart.
TOKEN_REGISTRY_URL=https://decentroneum.com/api/token-list.json
# How often to re-check for newly listed tokens (ms). 30 minutes.
TOKEN_REGISTRY_REFRESH_MS=1800000

# How often the HTTP reconcile safety net checks the WS subscriptions haven't
# silently missed anything (ms). Not the primary delivery path — see above.
RECONCILE_INTERVAL_MS=90000

# HTTP server
PORT=8787

# SQLite file path (created automatically)
DB_PATH=./data/push.db

# Require registration requests to include a signed proof-of-ownership
# (recommended for production — see src/verify.ts)
REQUIRE_SIGNATURE=true

# ── Market data (prices + price-line history) ────────────────────────────────
#
# Two free tiers, failing in opposite ways:
#
#   KEYLESS (default) — no signup, no monthly cap, BUT CoinGecko documents the
#     limit as "dynamic and managed to prioritize fair access" and scopes the
#     tier to "low-volume, client-side testing... non-commercial educational
#     use". An invisible, moving ceiling can't be respected by any fixed rate.
#
#   DEMO KEY (recommended for production) — free signup at
#     coingecko.com/en/api/pricing. STABLE 100 calls/min, hard cap of 10,000
#     calls/month, onchain/DEX endpoints included. Set MARKET_API_KEY and the
#     base URL + auth header switch over automatically.
#
# With a Demo key also set MARKET_API_MONTHLY_CAP=10000, so we stop short of
# the cap deliberately instead of being cut off mid-month.
MARKET_API_KEY=
MARKET_API_MONTHLY_CAP=0
# Which base URL + auth mechanism the key needs. CoinGecko's reference docs
# describe a header while their onboarding screen uses a query parameter, and
# neither states which is correct for the ONCHAIN endpoints — so don't guess:
#   npm run verify:key
# tries every combination against a live endpoint and prints the one that works.
# If the key is rejected the service falls back to the keyless root and keeps
# serving, so a wrong value here degrades the tier rather than breaking prices.
MARKET_API_KEYED_BASE_URL=https://api.coingecko.com/api/v3/onchain
MARKET_API_AUTH_MODE=header-demo

# Deliberately far below either tier's ceiling — steady-state need is about one
# call a minute, and there is no upside to running near an invisible limit.
# Spacing matters as much as rate: bursting a whole minute's allowance back to
# back tripped the throttle even when the average was well under it.
# Leave both UNSET unless you have a reason. The defaults adapt to the tier:
#   keyless -> 5/min, 12s apart  (ceiling is dynamic and invisible; stay far
#                                 below it — a 429 arrived at ~2/min in testing)
#   keyed   -> 30/min, 2s apart  (Demo publishes a fixed 100/min, so no guessing
#                                 is needed; 6x faster first backfill)
# This affects SPEED, not monthly VOLUME — total calls are set by the refresh
# cadences below, so going faster costs nothing against the 10,000/month cap.
# MARKET_API_MAX_CALLS_PER_MINUTE=
# MARKET_API_MIN_SPACING_MS=
# Random extra delay per call so a fixed schedule can't align with a fixed
# rate-limit window.
MARKET_API_JITTER_MS=3000

GECKOTERMINAL_NETWORK=electroneum

# THE pricing anchor: every token is priced through its pool against WETN and
# nothing else. Not "its deepest pool" — BOLT's deepest pool is DYNO/BOLT, and
# DYNO's only real pool is DYNO/BOLT, so that route is circular. Anchoring
# guarantees every price chain terminates at something already trusted.
ANCHOR_SYMBOL=WETN
ANCHOR_TOKEN_ADDRESS=0x138DAFbDA0CCB3d8E39C19edb0510Fc31b7C1c77

# Minimum pool liquidity (USD) before a price is published from it. This chain
# has pools with plausible names holding nothing — BOLT has `USDT / BOLT` and
# `BOLT / WETN 1%` holding between $1e-5 and $4e-19, and a pool with $4e-19 in
# it still returns an (arbitrary) spot price. Real pools here sit at $7k-$23k.
MIN_POOL_LIQUIDITY_USD=1000

# Pools are re-resolved rather than cached forever: liquidity migrates between
# V3 fee tiers, and we should follow it without an app release. Fee-tier
# migration is rare, so 12h is plenty and it's the cheapest job to slow down.
POOL_RESOLVE_INTERVAL_MS=43200000
# One call covers every token (pools/multi takes 30 addresses), so this is the
# cadence users actually feel.
PRICE_REFRESH_INTERVAL_MS=600000

# CoinGecko is used for EXACTLY ONE THING: the price of native ETN, which is a
# real listed market. Every token price comes from on-chain pools via
# GeckoTerminal. COINGECKO_API_KEY is optional — the keyless tier is heavily
# throttled, a free demo key raises the limit and changes nothing else.
COINGECKO_ETN_ID=electroneum
COINGECKO_API_KEY=
